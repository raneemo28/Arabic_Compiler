<قسم معرف="صفحة-الدخول" صنف="صفحة">
    <قسم صنف="بطاقة-الدخول">
        <عنوان>تسجيل الدخول</عنوان>
        <فقرة صنف="وصف">الرجاء إدخال بياناتك</فقرة>
        
        <نموذج معرف="نموذج-الدخول">
            <قسم صنف="حقل-مجموعة">
                <فقرة صنف="تسمية">البريد الإلكتروني</فقرة>
                <ادخال معرف="البريد" صنف="ادخال-نص" />
                <نص معرف="خطأ-البريد" صنف="رسالة-خطأ"></نص>
            </قسم>
            
            <قسم صنف="حقل-مجموعة">
                <فقرة صنف="تسمية">كلمة المرور</فقرة>
                <ادخال معرف="كلمة-المرور" صنف="ادخال-نص" />
                <نص معرف="خطأ-كلمة-المرور" صنف="رسالة-خطأ"></نص>
            </قسم>
            
            <زر معرف="زر-الدخول" صنف="زر-رئيسي">دخول</زر>
        </نموذج>
    </قسم>
</قسم>

.صفحة {
    عرض-المساحة: ١٠٠٪؛
    طول-المساحة: ١٠٠vh؛
    عرض: مرن؛
    ضبط-المحتوى: مركز؛
    محاذاة-العناصر: مركز؛
}

.بطاقة-الدخول {
    عرض-المساحة: ٤٠٠بكسل؛
    حشو: ٤٠بكسل؛
    لون-الخلفية: ابيض؛
    انحناء-الاطار: ١٢بكسل؛
}

.وصف {
    لون: رمادي؛
    حجم-الخط: ١٤بكسل؛
    هامش: ١٠بكسل؛
}

.حقل-مجموعة {
    هامش: ١٦بكسل؛
}

.تسمية {
    حجم-الخط: ١٤بكسل؛
    ثقل-الخط: عريض؛
    هامش: ٨بكسل؛
    عرض: كتلة؛
}

.ادخال-نص {
    عرض-المساحة: ١٠٠٪؛
    حشو: ١٠بكسل؛
    اطار: ١بكسل متصل رمادي؛
    انحناء-الاطار: ٦بكسل؛
}

.ادخال-نص:تركيز {
    اطار: ٢بكسل متصل ازرق؛
}

.رسالة-خطأ {
    لون: احمر؛
    حجم-الخط: ١٢بكسل؛
    هامش: ٤بكسل؛
    عرض: كتلة؛
}

.زر-رئيسي {
    عرض-المساحة: ١٠٠٪؛
    حشو: ١٢بكسل؛
    خلفية: ازرق؛
    لون: ابيض؛
    انحناء-الاطار: ٦بكسل؛
    حجم-الخط: ١٦بكسل؛
    ثقل-الخط: عريض؛
}

دع المستخدمين = [
    { بريد: "admin@example.com"، كلمة-مرور: "١٢٣٤٥٦" }،
    { بريد: "user@test.com"، كلمة-مرور: "password" }
]؛

دالة عرض-خطأ(المعرف، الرسالة) {
    دع العنصر = الوثيقة.احضرعنصر(المعرف)؛
    العنصر.النص-الداخلي = الرسالة؛
    العنصر.التنسيق.لون = "احمر"؛
}

دالة مسح-الأخطاء() {
    الوثيقة.احضرعنصر("خطأ-البريد").النص-الداخلي = ""؛
    الوثيقة.احضرعنصر("خطأ-كلمة-المرور").النص-الداخلي = ""؛
}

دالة تسجيل-الدخول() {
    مسح-الأخطاء()؛
    
    دع البريد = الوثيقة.احضرعنصر("البريد").القيمة؛
    دع كلمة-المرور = الوثيقة.احضرعنصر("كلمة-المرور").القيمة؛
    
    دع صالح = صحيح؛
    
    اذا (البريد === "") {
        عرض-خطأ("خطأ-البريد"، "البريد مطلوب")؛
        صالح = خاطئ؛
    }
    
    اذا (كلمة-المرور === "") {
        عرض-خطأ("خطأ-كلمة-المرور"، "كلمة المرور مطلوبة")؛
        صالح = خاطئ؛
    }
    
    اذا (صالح === صحيح) {
        دع مستخدم-موجود = خاطئ؛
        دع عداد = ٠؛
        
        طالما (عداد < المستخدمين.طول) {
            دع مستخدم = المستخدمين[عداد]؛
            اذا (مستخدم.بريد === البريد && مستخدم.كلمة-مرور === كلمة-المرور) {
                مستخدم-موجود = صحيح؛
            }
            عداد = عداد + ١؛
        }
        
        اذا (مستخدم-موجود === صحيح) {
            تنبيه("مرحباً! تم تسجيل الدخول بنجاح")؛
            اطبع("تم تسجيل دخول: "، البريد)؛
        } والا {
            عرض-خطأ("خطأ-البريد"، "البيانات غير صحيحة")؛
            تنبيه("بيانات الدخول غير صحيحة!")؛
        }
    }
}

دع زر-الدخول = الوثيقة.احضرعنصر("زر-الدخول")؛
زر-الدخول.استمع-للحدث("click"، تسجيل-الدخول)؛

اطبع("نموذج تسجيل الدخول جاهز")؛
اطبع("عدد المستخدمين: "، المستخدمين.طول)؛