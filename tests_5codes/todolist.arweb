<قسم معرف="تطبيق-المهام" صنف="تطبيق">
    <عنوان>قائمة مهامي</عنوان>
    <قسم صنف="شريط-الإدخال">
        <ادخال معرف="حقل-المهمة" />
        <زر معرف="زر-الإضافة">إضافة</زر>
    </قسم>
    <قائمة معرف="قائمة-المهام" صنف="قائمة">
    </قائمة>
    <فقرة معرف="عداد-المهام">عدد المهام صفر</فقرة>
</قسم>

.تطبيق {
    عرض-المساحة: ٤٠٠بكسل؛
    حشو: ٢٠بكسل؛
}

.شريط-الإدخال {
    عرض: مرن؛
    فجوة: ٨بكسل؛
    اتجاه-المرونة: سطر؛
}

.قائمة {
    نمط-القائمة: لا-شيء؛
    حشو: ٠؛
    هامش: ١٠بكسل؛
}

دع المهام = ["تعلم لغة عربي ويب"، "بناء أول مشروع"، "مشاركة المعرفة"]؛

دالة عرض-المهام() {
    دع القائمة = الوثيقة.احضرعنصر("قائمة-المهام")؛
    القائمة.النص-الداخلي = ""؛
    
    دع عداد:عدد = ٠؛
    طالما (عداد < المهام.طول) {
     القائمة.النص-الداخلي = القائمة.النص-الداخلي + " - " + المهام[عداد] ؛
        عداد = عداد + ١؛
    }
    
    دع الفقرة = الوثيقة.احضرعنصر("عداد-المهام")؛
    الفقرة.النص-الداخلي = "عدد المهام " + المهام.طول؛
}

دالة إضافة-مهمة() {
    دع الحقل = الوثيقة.احضرعنصر("حقل-المهمة")؛
    دع النص = الحقل.القيمة؛
    
    اذا (النص === "") {
        المراقب.اطبع("الرجاء كتابة مهمة!")؛
    } والا {
        المهام.ادفع(النص)؛
        الحقل.القيمة = ""؛
        عرض-المهام()؛
    }
}

دع زر-الإضافة = الوثيقة.احضرعنصر("زر-الإضافة")؛
زر-الإضافة.استمع-للحدث("click"، إضافة-مهمة)؛

عرض-المهام()؛