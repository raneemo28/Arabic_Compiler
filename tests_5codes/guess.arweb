<قسم معرف="تطبيق-التخمين" صنف="تطبيق">
    <عنوان>لعبة تخمين الرقم</عنوان>
    <فقرة معرف="الرسالة" صنف="رسالة">ابدأ التخمين الرقم بين ١ و ١٠٠</فقرة>
    
    <قسم صنف="شريط-الادخال">
        <ادخال معرف="حقل-التخمين" صنف="حقل" />
        <زر معرف="زر-التخمين" صنف="زر-تخمين">تخمن</زر>
    </قسم>
    
    <فقرة معرف="المحاولات" صنف="محاولات">عدد المحاولات ٠</فقرة>
    
    <زر معرف="زر-اعادة" صنف="زر-اعادة">لعبة جديدة</زر>
</قسم>

/* =========================================
   تنسيقات الواجهة (CSS)
   ========================================= */
.تطبيق {
    عرض-المساحة: ٤٠٠بكسل؛
    حشو: ٣٠بكسل؛
    محاذاة-النص: مركز؛
    لون-الخلفية: ابيض؛
    انحناء-الاطار: ١٢بكسل؛
    هامش: ٤٠بكسل تلقائي؛
    ظل-الصندوق: #00000022؛
}

.رسالة {
    حجم-الخط: ٢٠بكسل؛
    ثقل-الخط: عريض؛
    حشو: ٢٠بكسل؛
    هامش: ١٦بكسل؛
    انحناء-الاطار: ٨بكسل؛
    لون-الخلفية: #f8f9fa؛
}

.شريط-الادخال {
    عرض: مرن؛
    فجوة: ١٠بكسل؛
    ضبط-المحتوى: مركز؛
    هامش: ١٦بكسل؛
}

.حقل {
    حشو: ١٠بكسل؛
    حجم-الخط: ١٨بكسل؛
    عرض-المساحة: ١٥٠بكسل؛
    انحناء-الاطار: ٦بكسل؛
    اطار: #cccccc؛
    محاذاة-النص: مركز؛
}

.زر-تخمين {
    حشو: ٢٠بكسل؛
    حجم-الخط: ١٦بكسل؛
    لون-الخلفية: ازرق؛
    لون: ابيض؛
    انحناء-الاطار: ٦بكسل؛
    اطار: لا-شيء؛
}

.زر-تخمين:حوم {
    لون-الخلفية: اسود؛
}

.محاولات {
    حجم-الخط: ١٦بكسل؛
    لون: رمادي؛
    هامش: ٨بكسل؛
}

.زر-اعادة {
    حشو: ٨بكسل؛
    حجم-الخط: ١٤بكسل؛
    لون-الخلفية: #6c757d؛
    لون: ابيض؛
    انحناء-الاطار: ٦بكسل؛
    اطار: لا-شيء؛
    هامش: ١٦بكسل؛
}

/* =========================================
   منطق اللعبة (TypeScript)
   ========================================= */
دع الرقم-السري: عدد = ٤٢؛
دع عدد-المحاولات: عدد = ٠؛
دع انتهت-اللعبة: منطقي = خاطئ؛

دالة تحقق-من-التخمين() {
    اذا (انتهت-اللعبة === صحيح) {
        ارجع؛
    }

    دع الحقل = الوثيقة.احضرعنصر("حقل-التخمين")؛
    دع نص-التخمين = الحقل.القيمة؛

    اذا (نص-التخمين === "") {
        تنبيه("الرجاء إدخال رقم")؛
        ارجع؛
    }

    // تحويل النص إلى رقم بالضرب في 1
    دع التخمين = نص-التخمين * ١؛

    // حيلة ذكية للتحقق من أن الرقم صحيح (ليس NaN)
    اذا (التخمين !== التخمين) {
        تنبيه("الرجاء إدخال رقم صحيح")؛
        الحقل.القيمة = ""؛
        ارجع؛
    }

    عدد-المحاولات = عدد-المحاولات + ١؛

    دع رسالة = الوثيقة.احضرعنصر("الرسالة")؛
    دع محاولات = الوثيقة.احضرعنصر("المحاولات")؛
    محاولات.النص-الداخلي = "عدد المحاولات " + عدد-المحاولات؛

    اذا (التخمين === الرقم-السري) {
        رسالة.النص-الداخلي = "صحيح لقد خمّنت الرقم في " + عدد-المحاولات + " محاولة"؛
        انتهت-اللعبة = صحيح؛
        اطبع("انتهت اللعبة عدد المحاولات "، عدد-المحاولات)؛
    }
    والا اذا (التخمين < الرقم-السري) {
        رسالة.النص-الداخلي = "الرقم أكبر من ذلك حاول مرة أخرى"؛
    }
    والا {
        رسالة.النص-الداخلي = "الرقم أصغر من ذلك حاول مرة أخرى"؛
    }
    
    الحقل.القيمة = ""؛
}

دالة اعادة-اللعبة() {
    الرقم-السري = ٤٢؛
    عدد-المحاولات = ٠؛
    انتهت-اللعبة = خاطئ؛
    
    الوثيقة.احضرعنصر("الرسالة").النص-الداخلي = "ابدأ التخمين الرقم بين ١ و ١٠٠"؛
    الوثيقة.احضرعنصر("المحاولات").النص-الداخلي = "عدد المحاولات ٠"؛
    الوثيقة.احضرعنصر("حقل-التخمين").القيمة = ""؛
    
    اطبع("تم بدء لعبة جديدة")؛
}

دع زر-التخمين = الوثيقة.احضرعنصر("زر-التخمين")؛
دع زر-اعادة = الوثيقة.احضرعنصر("زر-اعادة")؛

زر-التخمين.استمع-للحدث("click"، تحقق-من-التخمين)؛
زر-اعادة.استمع-للحدث("click"، اعادة-اللعبة)؛

// بدء اللعبة عند تحميل الصفحة
اعادة-اللعبة()؛