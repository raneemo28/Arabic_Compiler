<قسم معرف="حاسبة" صنف="حاسبة-تصميم">
    <عنوان>الآلة الحاسبة</عنوان>
    <نص معرف="شاشة-الحاسبة" صنف="شاشة">٠</نص>
    <قسم صنف="لوحة">
        <زر معرف="ز٧">٧</زر>
        <زر معرف="ز٨">٨</زر>
        <زر معرف="ز٩">٩</زر>
        <زر معرف="ز-قسمة">÷</زر>
        <زر معرف="ز٤">٤</زر>
        <زر معرف="ز٥">٥</زر>
        <زر معرف="ز٦">٦</زر>
        <زر معرف="ز-ضرب">×</زر>
        <زر معرف="ز١">١</زر>
        <زر معرف="ز٢">٢</زر>
        <زر معرف="ز٣">٣</زر>
        <زر معرف="ز-طرح">-</زر>
        <زر معرف="ز٠">٠</زر>
        <زر معرف="ز-مسح">م</زر>
        <زر معرف="ز-حساب">=</زر>
    </قسم>
</قسم>

.حاسبة-تصميم {
    عرض-المساحة: ٣٢٠بكسل؛
    حشو: ٢٠بكسل؛
    لون-الخلفية: اسود؛
    انحناء-الاطار: ١٦بكسل؛
}

.شاشة {
    عرض: كتلة؛
    حجم-الخط: ٣٦بكسل؛
    لون: اخضر؛
    حشو: ٢٠بكسل؛
    محاذاة-النص: يمين؛
    هامش: ١٠بكسل؛
}

.لوحة {
    عرض: شبكة؛
    فجوة: ٨بكسل؛
}

دع التعبير = ""؛
دع الشاشة = الوثيقة.احضرعنصر("شاشة-الحاسبة")؛

دالة تحديث-الشاشة() {
    اذا (التعبير === "") {
        الشاشة.النص-الداخلي = "٠"؛
    } والا {
        الشاشة.النص-الداخلي = التعبير؛
    }
}

دالة إضافة-رقم(الرقم) {
    التعبير = التعبير + الرقم؛
    تحديث-الشاشة()؛
}

دالة مسح() {
    التعبير = ""؛
    تحديث-الشاشة()؛
}

دالة حساب() {
    حاول {
        اطبع("النتيجة: "، التعبير)؛
    } امسك (خطأ) {
        تنبيه("حدث خطأ!")؛
    }
}

دع الارقام = ["٠"، "١"، "٢"، "٣"، "٤"، "٥"، "٦"، "٧"، "٨"، "٩"]؛

حلقة (ثابت رقم في الارقام) {
    دع معرف-الزر = "ز" + رقم؛
    دع الزر = الوثيقة.احضرعنصر(معرف-الزر)؛
    اذا (الزر !== غير-معرف) {
        الزر.استمع-للحدث("click"، دالة() { إضافة-رقم(رقم)؛ })؛
    }
}

الوثيقة.احضرعنصر("ز-مسح").استمع-للحدث("click"، مسح)؛
الوثيقة.احضرعنصر("ز-حساب").استمع-للحدث("click"، حساب)؛
الوثيقة.احضرعنصر("ز-قسمة").استمع-للحدث("click"، دالة() { إضافة-رقم("/") })؛
الوثيقة.احضرعنصر("ز-ضرب").استمع-للحدث("click"، دالة() { إضافة-رقم("*") })؛
الوثيقة.احضرعنصر("ز-طرح").استمع-للحدث("click"، دالة() { إضافة-رقم("-") })؛

تحديث-الشاشة()؛