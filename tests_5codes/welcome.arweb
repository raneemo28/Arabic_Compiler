<راس>
    <عنوان>أهلاً وسهلاً</عنوان>
    <فقرة>هذه أول صفحة بلغة عربي ويب</فقرة>
</راس>

<قسم معرف="محتوى" صنف="بطاقة">
    <عنوان>عن الفريق</عنوان>
    <فقرة>نحن فريق تطوير يهدف لبناء أدوات عربية</فقرة>
    <زر>اعرف المزيد</زر>
</قسم>

<تذييل>
    <فقرة>جميع الحقوق محفوظة ٢٠٢٦</فقرة>
</تذييل>

#محتوى {
    حشو: ٢٠بكسل؛
    هامش: ١٠بكسل؛
    لون-الخلفية: ابيض؛
    انحناء-الاطار: ٨بكسل؛
}

.بطاقة {
    عرض: كتلة؛
    عرض-المساحة: ٤٠٠بكسل؛
    محاذاة-النص: مركز؛
}

زر {
    خلفية: ازرق؛
    لون: ابيض؛
    حشو: ١٠بكسل؛
}

زر:حوم {
    لون-الخلفية: اسود؛
}