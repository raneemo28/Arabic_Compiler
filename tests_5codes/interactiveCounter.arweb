<قسم معرف="عداد-قسم" صنف="حاوية">
    <عنوان>العداد التفاعلي</عنوان>
    <نص معرف="شاشة" صنف="شاشة-العداد">٠</نص>
    <قسم صنف="أزرار">
        <زر معرف="زر-ناقص">ناقص</زر>
        <زر معرف="زر-تصفير">تصفير</زر>
        <زر معرف="زر-زائد">زائد</زر>
    </قسم>
</قسم>

.حاوية {
    حشو: ٣٠بكسل؛
    محاذاة-النص: مركز؛
    عرض-المساحة: ٣٠٠بكسل؛
    انحناء-الاطار: ١٢بكسل؛
}

.شاشة-العداد {
    حجم-الخط: ٤٨بكسل؛
    ثقل-الخط: عريض؛
    لون: ازرق؛
    عرض: كتلة؛
    حشو: ٢٠بكسل؛
}

.أزرار {
    عرض: مرن؛
    فجوة: ١٠بكسل؛
    ضبط-المحتوى: مركز؛
}

دع العداد: عدد  = ٠؛

دالة تحديث-الشاشة() {
    دع الشاشة = الوثيقة.احضرعنصر("شاشة")؛
    الشاشة.النص-الداخلي = العداد؛
    اطبع("القيمة الحالية: "، العداد)؛
}

دالة زيادة() {
    العداد = العداد + ١؛
    تحديث-الشاشة()؛
}

دالة نقصان() {
    العداد = العداد - ١؛
    تحديث-الشاشة()؛
}

دالة تصفير() {
    العداد = ٠؛
    تحديث-الشاشة()؛
    المراقب.اطبع("تم تصفير العداد!")؛
}

دع زر-زائد = الوثيقة.احضرعنصر("زر-زائد")؛
دع زر-ناقص = الوثيقة.احضرعنصر("زر-ناقص")؛
دع زر-تصفير = الوثيقة.احضرعنصر("زر-تصفير")؛

زر-زائد.استمع-للحدث("نقر"، زيادة)؛
زر-ناقص.استمع-للحدث("نقر"، نقصان)؛
زر-تصفير.استمع-للحدث("نقر"، تصفير)؛

تحديث-الشاشة()؛