<قسم معرف="تطبيق-الاختبار" صنف="تطبيق">
    <عنوان>اختبار المعرفة</عنوان>
    <فقرة معرف="رقم-السؤال" صنف="وصف">السؤال الاول</فقرة>

    <قسم معرف="لوحة-السؤال" صنف="بطاقة">
        <فقرة معرف="نص-السؤال" صنف="سؤال"></فقرة>

        <قسم معرف="خيارات-الإجابة" صنف="خيارات">
            <زر معرف="خيار-الف" صنف="زر-خيار"></زر>
            <زر معرف="خيار-باء" صنف="زر-خيار"></زر>
            <زر معرف="خيار-جيم" صنف="زر-خيار"></زر>
            <زر معرف="خيار-دال" صنف="زر-خيار"></زر>
        </قسم>

        <نص معرف="ردة-الفعل" صنف="رسالة-نتيجة"></نص>
    </قسم>

    <قسم صنف="شريط-التقدم">
        <فقرة معرف="عرض-النتيجة" صنف="نتيجة-كبيرة">النتيجة</فقرة>
        <زر معرف="زر-التالي" صنف="زر-رئيسي">السؤال التالي</زر>
    </قسم>
</قسم>

.تطبيق {
    عرض-المساحة: ٤٨٠بكسل؛
    حشو: ٣٠بكسل؛
    محاذاة-النص: مركز؛
}

.وصف {
    لون: رمادي؛
    حجم-الخط: ١٤بكسل؛
    هامش: ٨بكسل؛
}

.بطاقة {
    حشو: ٢٤بكسل؛
    لون-الخلفية: ابيض؛
    انحناء-الاطار: ١٢بكسل؛
    هامش: ١٦بكسل؛
}

.سؤال {
    حجم-الخط: ٢٠بكسل؛
    ثقل-الخط: عريض؛
    هامش: ١٦بكسل؛
    لون: اسود؛
}

.خيارات {
    عرض: مرن؛
    اتجاه-المرونة: عمود؛
    فجوة: ١٠بكسل؛
    هامش: ١٦بكسل؛
}

.زر-خيار {
    حشو: ١٢بكسل؛
    اطار: ٢بكسل متصل رمادي؛
    انحناء-الاطار: ٨بكسل؛
    حجم-الخط: ١٦بكسل؛
    لون-الخلفية: ابيض؛
}

.زر-خيار:حوم {
    لون-الخلفية: ازرق؛
    لون: ابيض؛
}

.رسالة-نتيجة {
    حجم-الخط: ١٦بكسل؛
    ثقل-الخط: عريض؛
    هامش: ١٢بكسل؛
    عرض: كتلة؛
}

.شريط-التقدم {
    عرض: مرن؛
    ضبط-المحتوى: مركز؛
    محاذاة-العناصر: مركز؛
    فجوة: ١٦بكسل؛
    هامش: ٨بكسل؛
}

.نتيجة-كبيرة {
    حجم-الخط: ٢٢بكسل؛
    ثقل-الخط: عريض؛
    لون: ازرق؛
}

.زر-رئيسي {
    حشو: ١٢بكسل؛
    عرض-المساحة: ١٦٠بكسل؛
    خلفية: ازرق؛
    لون: ابيض؛
    انحناء-الاطار: ٨بكسل؛
    حجم-الخط: ١٦بكسل؛
    ثقل-الخط: عريض؛
}

.زر-رئيسي:حوم {
    لون-الخلفية: اسود؛
}

دع نص-سؤال-اول = "ما هي عاصمة المملكة العربية السعودية؟"؛
دع نص-سؤال-ثاني = "كم عدد أيام السنة؟"؛
دع نص-سؤال-ثالث = "ما هي لغة القرآن الكريم؟"؛

دع خيارات-اول = ["دبي"، "الرياض"، "جدة"، "مكة"]؛
دع خيارات-ثاني = ["300"، "350"، "365"، "400"]؛
دع خيارات-ثالث = ["الفارسية"، "العبرية"، "العربية"، "التركية"]؛

دع إجابة-اول: عدد = ١؛
دع إجابة-ثاني: عدد = ٢؛
دع إجابة-ثالث: عدد = ٢؛

دع نصوص-الأسئلة = [نص-سؤال-اول، نص-سؤال-ثاني، نص-سؤال-ثالث]؛
دع قائمة-الخيارات = [خيارات-اول، خيارات-ثاني، خيارات-ثالث]؛
دع قائمة-الإجابات = [إجابة-اول، إجابة-ثاني، إجابة-ثالث]؛

دع السؤال-الحالي: عدد = ٠؛
دع النتيجة-الحالية: عدد = ٠؛
دع تم-الإجابة: منطقي = خاطئ؛

دع معرفات-الخيارات: سلسلة[] = ["خيار-الف"، "خيار-باء"، "خيار-جيم"، "خيار-دال"]؛

دالة عرض-السؤال() {
    تم-الإجابة = خاطئ؛

    دع نص-السؤال: اي = نصوص-الأسئلة[السؤال-الحالي]؛
    دع خيارات-السؤال: اي = قائمة-الخيارات[السؤال-الحالي]؛

    الوثيقة.احضرعنصر("نص-السؤال").النص-الداخلي = نص-السؤال؛
    الوثيقة.احضرعنصر("ردة-الفعل").النص-الداخلي = ""؛
    الوثيقة.احضرعنصر("رقم-السؤال").النص-الداخلي = "السؤال " + (السؤال-الحالي + ١)؛

    دع عداد = ٠؛
    طالما (عداد < خيارات-السؤال.طول) {
        دع اسم-المعرف = معرفات-الخيارات[عداد]؛
        الوثيقة.احضرعنصر(اسم-المعرف).النص-الداخلي = خيارات-السؤال[عداد]؛
        عداد = عداد + ١؛
    }

    اطبع("تم عرض السؤال رقم: "، السؤال-الحالي + ١)؛
}

دالة تحقق-الإجابة(رقم-الخيار: عدد) {
    اذا (تم-الإجابة === صحيح) {
        ارجع؛
    }

    تم-الإجابة = صحيح؛
    دع الإجابة-الصحيحة:اي = قائمة-الإجابات[السؤال-الحالي]؛
    دع الرد: اي = الوثيقة.احضرعنصر("ردة-الفعل")؛

    اذا (رقم-الخيار === الإجابة-الصحيحة) {
        النتيجة-الحالية = النتيجة-الحالية + ١؛
        الرد.النص-الداخلي = "اجابة صحيحة!"؛
        اطبع("إجابة صحيحة! النتيجة: "، النتيجة-الحالية)؛
    } والا {
        الرد.النص-الداخلي = "اجابة خاطئة!"؛
        اطبع("إجابة خاطئة.")؛
    }

    الوثيقة.احضرعنصر("عرض-النتيجة").النص-الداخلي = "النتيجة: " + النتيجة-الحالية؛
}

دالة اختار-الف() {
    تحقق-الإجابة(٠)؛
}

دالة اختار-باء() {
    تحقق-الإجابة(١)؛
}

دالة اختار-جيم() {
    تحقق-الإجابة(٢)؛
}

دالة اختار-دال() {
    تحقق-الإجابة(٣)؛
}

دالة السؤال-التالي() {
    اذا (تم-الإجابة === خاطئ) {
        تنبيه("الرجاء اختيار إجابة اولاً!")؛
        ارجع؛
    }

    السؤال-الحالي = السؤال-الحالي + ١؛

    اذا (السؤال-الحالي < نصوص-الأسئلة.طول) {
        عرض-السؤال()؛
    } والا {
        تنبيه("انتهى الاختبار! نتيجتك: " + النتيجة-الحالية)؛
        اطبع("انتهى الاختبار. النتيجة النهائية: "، النتيجة-الحالية)؛
    }
}

دع زر-التالي: اي = الوثيقة.احضرعنصر("زر-التالي")؛
زر-التالي.استمع-للحدث("click"، السؤال-التالي)؛

دع زر-الف = الوثيقة.احضرعنصر("خيار-الف")؛
دع زر-الباء = الوثيقة.احضرعنصر("خيار-باء")؛
دع زر-الجيم = الوثيقة.احضرعنصر("خيار-جيم")؛
دع زر-الدال = الوثيقة.احضرعنصر("خيار-دال")؛

زر-الف.استمع-للحدث("النقر"، اختار-الف)؛
زر-الباء.استمع-للحدث("click"، اختار-باء)؛
زر-الجيم.استمع-للحدث("click"، اختار-جيم)؛
زر-الدال.استمع-للحدث("click"، اختار-دال)؛

عرض-السؤال()؛
اطبع("تطبيق الاختبار جاهز. عدد الأسئلة: "، نصوص-الأسئلة.طول)؛
