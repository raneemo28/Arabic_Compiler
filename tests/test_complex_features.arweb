قسم {
    عرض-المساحة: ٣٠٠بكسل؛
    هامش: ٢٠بكسل؛
    حشو: ١٥بكسل؛
    لون-الخلفية: نظام-ر-ج-ب(٢٤٠، ٢٤٠، ٢٤٠)؛
    نمط-الاطار: متصل؛
    انحناء-الاطار: ١٠بكسل؛
}

.راس-الصفحة {
    عرض: مرن؛
    ضبط-المحتوى: مركز؛
    محاذاة-العناصر: مركز؛
    لون-الخلفية: ازرق؛
    حشو: ١٠بكسل؛
}

زر {
    لون: ابيض؛
    لون-الخلفية: اخضر؛
    حشو: ١٠بكسل؛
    نمط-الاطار: لا-شيء؛
    حجم-الخط: ١٦بكسل؛
}

#نتيجة {
    حجم-الخط: ٢٠بكسل؛
    ثقل-الخط: عريض؛
}

@وسائط شاشة {
    حجم-الخط: ١٤بكسل؛
}

دالة اضرب(ا: عدد، ب: عدد) {
    ارجع ا * ب؛
}

دالة احسب-الكل(ا: عدد، ب: عدد، ج: عدد) {
    ثابت ضرب: عدد = اضرب(ا، ب)؛
    ثابت ناتج: عدد = ضرب + ج؛
    ارجع ناتج؛
}

ثابت النتيجة-النهائية: عدد = احسب-الكل(٢، ٣، ٤)؛
اطبع(النتيجة-النهائية)؛

متغير المجموع: عدد = ٠؛
حلقة (متغير فهرس: عدد = ١؛ فهرس <= ٥؛ فهرس = فهرس + ١) {
    المجموع = المجموع + فهرس؛
}
اطبع(المجموع)؛

متغير محاولات: عدد = ٠؛
متغير نجح: منطقي = خاطئ؛
طالما (محاولات < ٣ && نجح == خاطئ) {
    محاولات = محاولات + ١؛
    اذا (محاولات == ٣) {
        نجح = صحيح؛
    }
}
اطبع(محاولات)؛

حاول {
    ثابت قيمة: عدد = اضرب(٥، ٢)؛
    اطبع(قيمة)؛
} امسك (خطا) {
    اطبع("حدث خطا")؛
} اخيرا {
    اطبع("انتهت المحاولة")؛
}

<صفحة>
<راس صنف="راس-الصفحة">
<عنوان>متجر تجريبي</عنوان>
</راس>
<تنقل>
<قائمة>
<عنصر-قائمة><رابط وجهة="#الرئيسية">الرئيسية</رابط></عنصر-قائمة>
<عنصر-قائمة><رابط وجهة="#المنتجات">المنتجات</رابط></عنصر-قائمة>
</قائمة>
</تنقل>
<قسم معرف="نتيجة">
<فقرة>النتيجة النهائية هي</فقرة>
<صورة مصدر="result.png" />
اطبع("تم عرض القسم")؛
</قسم>
<نموذج>
<ادخال معرف="بحث" />
<زر>ابحث</زر>
</نموذج>
</صفحة>