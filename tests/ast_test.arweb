<صفحة معرف="الصفحة-الرئيسية">

    <رأس صنف="رأس-الموقع">
        <عنوان صنف="شعار">"متجر العربية"</عنوان>
        <قائمة صنف="قائمة-تنقل">
            <عنصر><رابط وجهة="#الرئيسية">"الرئيسية"</رابط></عنصر>
            <عنصر><رابط وجهة="#المنتجات">"المنتجات"</رابط></عنصر>
            <عنصر><رابط وجهة="#التواصل">"تواصل معنا"</رابط></عنصر>
        </قائمة>
    </رأس>

    رأس-الموقع {
        خلفية: #1a1a2e؛
        لون: #ffffff؛
        حشو: 20بكسل؛
        عرض: مرونة؛
        ضبط-المحتوى: مركز؛
    }

    شعار {
        حجم-الخط: 28بكسل؛
        ثقل-الخط: عريض؛
        لون: #e94560؛
    }

    <قسم معرف="البانر" صنف="قسم-بانر">
        <عنوان>"مرحباً بك في متجرنا الإلكتروني"</عنوان>
        <فقرة>"نوفر أفضل المنتجات بأسعار مناسبة"</فقرة>
        <زر صنف="زر-رئيسي">"تسوق الآن"</زر>
        <صورة مصدر="banner.jpg"/>
    </قسم>

    #البانر {
        خلفية: #16213e؛
        لون: #ffffff؛
        حشو: 60بكسل؛
        محاذاة-النص: مركز؛
        ارتفاع-السطر: 2؛
    }

    .زر-رئيسي {
        خلفية: #e94560؛
        لون: #ffffff؛
        حشو: 12بكسل؛
        انحناء-الإطار: 5بكسل؛
        إطار: لا-شيء؛
        حجم-الخط: 16بكسل؛
    }

    <قسم معرف="المنتجات">
        <عنوان>"منتجاتنا المميزة"</عنوان>

        <بطاقة صنف="بطاقة-منتج">
            <صورة مصدر="product1.jpg"/>
            <عنوان>"منتج أول"</عنوان>
            <فقرة>"وصف المنتج الأول هنا"</فقرة>
            <زر صنف="زر-شراء">"أضف للسلة"</زر>
        </بطاقة>

        <بطاقة صنف="بطاقة-منتج">
            <صورة مصدر="product2.jpg"/>
            <عنوان>"منتج ثانٍ"</عنوان>
            <فقرة>"وصف المنتج الثاني هنا"</فقرة>
            <زر صنف="زر-شراء">"أضف للسلة"</زر>
        </بطاقة>
    </قسم>

    .بطاقة-منتج {
        إطار: 1بكسل؛
        انحناء-الإطار: 8بكسل؛
        حشو: 16بكسل؛
        هامش: 12بكسل؛
        ظل-الصندوق: 5بكسل؛
        عرض: 250بكسل؛
    }

    لنفرض السلة = []؛

    دالة أضف_للسلة(اسم_المنتج) {
        السلة[0] = اسم_المنتج؛
        المراقب.اطبع(السلة)؛
    }

    دالة احسب_المجموع(كمية) {
        ثابت المجموع = 0؛
        لنفرض العداد = 0؛
        طالما (العداد > 0) {
            العداد -= 1؛
        }
        أرجع المجموع؛
    }

    دالة التحقق_من_المخزون(كمية) {
        إذا (كمية > 10) {
            أرجع "متوفر"؛
        } وإلا {
            إذا (كمية > 0) {
                أرجع "كمية محدودة"؛
            } وإلا {
                أرجع "نفذ المخزون"؛
            }
        }
    }

    ثابت عناوين = ["الرئيسية"، "المنتجات"، "التواصل"]؛

    ثابت إعدادات = { اللغة: "ar"، الاتجاه: "rtl" }؛

    لنفرض المتغير = 42؛
    المتغير += 1؛

    الوثيقة.عند_الحدث("DOMContentLoaded"، أضف_للسلة)؛
    تنبيه("تم تحميل الصفحة")؛

    <تذييل صنف="تذييل-الموقع">
        <فقرة>"© 2025 متجر العربية - جميع الحقوق محفوظة"</فقرة>
    </تذييل>

    .تذييل-الموقع {
        خلفية: #1a1a2e؛
        لون: #aaaaaa؛
        محاذاة-النص: مركز؛
        حشو: 20بكسل؛
        نوع-الخط: "Tajawal"؛
        اتجاه-الكتابة: نسبي؛
    }

</صفحة>