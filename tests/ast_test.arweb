<صفحة معرف="الصفحة-الرئيسية">

    <رأس صنف="رأس-الموقع">
        <عنوان صنف="شعار">"متجر العربية"</عنوان>
        <قائمة صنف="قائمة-تنقل">
            <عنصر><رابط وجهة="#الرئيسية">"الرئيسية"</رابط></عنصر>
            <عنصر><رابط وجهة="#المنتجات">"المنتجات"</رابط></عنصر>
            <عنصر><رابط وجهة="#التواصل">"تواصل معنا"</رابط></عنصر>
        </قائمة>
    </رأس>

    رأس-الموقع {
        خلفية: #1a1a2e؛
        لون: #ffffff؛
        حشو: 20بكسل؛
        عرض: مرونة؛
        ضبط-المحتوى: مركز؛
    }


    لنفرض السلة = []؛

   

    دالة احسب_المجموع(كمية) {
        ثابت المجموع = 0؛
        لنفرض العداد = 0؛
        طالما (العداد > 0) {
            العداد -= 1؛
        }
        أرجع المجموع؛
    }

   
</صفحة>