<صفحة>
    <عنوان>مرحبا</عنوان>
</صفحة>

لوحة {
    لون: أحمر؛
    هامش: 10بكسل؛
}

ثابت اسم: سلسلة = "علي"؛
ثابت أرقام: عدد[] = [1، 2، 3]؛

<صفحة معرف="رئيسية">
    <عنوان>مرحبا</عنوان>
    <صورة مصدر="test.png"/>
</صفحة>

لوحة {
    لون-الخلفية: #FF0000؛
    عرض: تلقائي؛
}

ثابت اسم: سلسلة = "علي"؛
ثابت أرقام: عدد[] = [1، 2، 3]؛

دالة مرحبا(اسم) {
    اطبع("مرحبا")؛
}

اذا (صحيح) {
    ثابت س: عدد = 5؛
}

// --- JsAssignmentStatementNode ---
ثابت عداد: عدد = 0؛
عداد = 10؛

// --- JsForLoopNode ---
حلقة (ثابت ي: عدد = 0؛ ي؛ ي) {
    اطبع("حلقة")؛
}

// --- JsWhileLoopNode ---
طالما (صحيح) {
    اطبع("تكرار")؛
}

// --- JsTryCatchNode ---
حاول {
    اطبع("محاولة")؛
} امسك (خطأ) {
    اطبع("خطأ")؛
} اخيرا {
    اطبع("أخيرا")؛
}

// --- JsInterfaceDeclarationNode ---
واجهة مستخدم { }