<حاوية>
    لوحة {
        عرض: كتلة؛
        لون-الخلفية: #f0f0f0؛
        هامش: 20بكسل؛
        حشو: 10بكسل؛
        انحناء-الإطار: 5بكسل؛
        محاذاة-النص: مركز؛
    }

    <عنوان>"أهلاً بك في برمجة الويب بالعربية"</عنوان>
    
    <زر>"انقر هنا"</زر>

    دالة ترحيب() {
        ثابت الرسالة = "مرحباً بك في موقعنا!"؛
        المراقب.اطبع(الرسالة)؛
        
        لنفرض العدد = 5؛
        إذا (العدد > 0) {
            تنبيه("العدد موجب")؛
        } وإلا {
            تنبيه("العدد غير ذلك")؛
        }
    }

    الوثيقة.عند_الحدث("click"، ترحيب)؛
</حاوية>