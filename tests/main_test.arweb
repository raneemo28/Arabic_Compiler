لوحة { لون: بني؛ هامش: ١٠بكسل؛ }
.بطاقة { خلفية: #F0F0F0؛ حشو: ٢٠بكسل؛ نمط-الاطار: متصل؛ }
#رئيسي { عرض-المساحة: ١٠٠بكسل؛ }

<صفحة>
<عنوان معرف="رئيسي" صنف="بطاقة">
مرحباً بالعالم
</عنوان>
<صورة مصدر="cat.png" />
</صفحة>

ثابت اسم: سلسلة = "علي"؛
ثابت ارقام: عدد[] = [١، ٢، ٣]؛
ثابت اعدادات = { العرض: ١٠٠، الارتفاع: ٢٠٠ }؛
متغير عداد: عدد = ٣؛

دالة جمع(ا: عدد، ب: عدد) {
    ارجع ا + ب؛
}

ثابت ناتج: عدد = جمع(٢، ٣)؛
اطبع(ناتج)؛

اذا (عداد) {
    اطبع("عداد غير صفري")؛
} الا {
    اطبع("عداد صفر")؛
}

طالما (عداد) {
    اطبع(عداد)؛
    عداد = عداد - ١؛
}

حلقة (متغير فهرس: عدد = ٠؛ فهرس < ٣؛ فهرس = فهرس + ١) {
    اطبع(فهرس)؛
}