ثابت أ: عدد[] = [١، ٢]؛
ثابت ب: عدد[] = [٣، ٤]؛
ثابت كلمات: سلسلة[] = ["نص"]؛

ثابت جمع_مصفوفات: عدد = أ + ب؛
ثابت ترتيب_مصفوفات: منطقي = أ < ب؛
ثابت تساوي_مختلف: منطقي = أ == كلمات؛
ثابت تساوي_متوافق: منطقي = أ == ب؛
ثابت رقم_من_مصفوفة: عدد = أ؛
ثابت مصفوفة_من_رقم: عدد[] = ٥؛
ثابت منطق_مصفوفات: منطقي = أ && ب؛
