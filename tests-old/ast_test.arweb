<صفحة معرف="الصفحة-الرئيسية">

    <راس معرف="راس-الموقع">
        <عنوان معرف="شعار">"متجر العربية"</عنوان>
        <قائمة معرف="قائمة-تنقل">
            <عنصر><رابط وجهة="#الرئيسية">"الرئيسية"</رابط></عنصر>
            <عنصر><رابط وجهة="#المنتجات">"المنتجات"</رابط></عنصر>
            <عنصر><رابط وجهة="#التواصل">"تواصل معنا"</رابط></عنصر>
        </قائمة>
    </راس>
</صفحة>
    راس-الموقع {
        خلفية: #1a1a2e؛
        لون: #ffffff؛
        حشو: 20بكسل؛
        عرض: مرونة؛
        ضبط-المحتوى: مركز؛
    }

